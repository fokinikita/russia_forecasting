# Copy to .env (never commit .env) and fill in.

# S3 storage (Timeweb Cloud)
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_BUCKET=russia-forecasting-iep-prod
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# optional root folder inside the bucket (empty = bucket root)
S3_PREFIX=

# Airflow web UI: user "admin"
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_PORT=8095

# resources of the container (the server is shared) and parallel model processes
MEM_LIMIT=12g
CPUS=10
N_JOBS=8
MFBVAR_N_JOBS=8
DFM_N_JOBS=2
